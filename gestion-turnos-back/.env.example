APP_NAME=GestionTurnos
APP_ENV=local
# Generar con: php artisan key:generate
APP_KEY=
# ⚠️ EN PRODUCCIÓN SIEMPRE false: con true, cualquier error muestra el stack
# trace COMPLETO, incluidas las credenciales de la base de datos.
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gestion_turnos
DB_USERNAME=laravel
DB_PASSWORD=cambiar_en_local
# Solo lo consume el contenedor mysql de docker-compose.
MYSQL_ROOT_PASSWORD=cambiar_en_local

# "reverb" en local (docker-compose, sin cuenta externa) o "pusher" en el
# deploy público, que no puede mantener corriendo un proceso de socket propio.
BROADCAST_CONNECTION=reverb
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax
# En producción (HTTPS) debe ser true: la cookie de sesión no debe viajar en claro.
SESSION_SECURE_COOKIE=false

REDIS_HOST=redis
# Obligatoria: docker-compose arranca Redis con --requirepass.
# Generar con: openssl rand -base64 24
REDIS_PASSWORD=cambiar_en_local
REDIS_PORT=6379

# Minutos de validez del token de sesión (8 h). Vacío = nunca expira: no usar.
SANCTUM_EXPIRATION=480

# Contraseña de los usuarios de prueba que crean los seeders.
# Los seeders de usuarios NO corren en producción.
SEED_PASSWORD=password123

FRONTEND_URL=http://localhost:5173

# Minutos desde el llamado (o desde que espera en cola) para que la Torre de
# Control de admin marque una sala en retraso crítico.
CONTROL_TOWER_RETRASO_MINUTOS=20

# Configuración de Laravel Reverb (WebSockets)
REVERB_APP_ID=gestion-turnos
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Host/puerto que usa el navegador para conectarse al WebSocket.
# docker-compose sobrescribe REVERB_HOST=reverb dentro de la red interna.
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Necesario para que Reverb escuche desde el contenedor Docker
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Pusher — solo si BROADCAST_CONNECTION=pusher (deploy público).
# Se consiguen en https://dashboard.pusher.com, pestaña "App Keys".
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

