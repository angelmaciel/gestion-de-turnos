# Vite proxea /api hacia el backend (ver vite.config.js), así que basta la ruta relativa.
VITE_API_BASE_URL=/api

# Tiempo real: "reverb" (default, local) o "pusher" (deploy público).
# Ojo: todo lo que empiece con VITE_ termina dentro del bundle del navegador.
VITE_BROADCASTER=reverb

# Reverb — local, vía docker-compose. Debe coincidir con REVERB_APP_KEY del backend.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Pusher — solo si VITE_BROADCASTER=pusher. La key es pública (viaja al
# navegador a propósito); el secret NUNCA va acá, solo en el backend.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
