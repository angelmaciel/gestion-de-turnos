# Vite proxea /api hacia el backend (ver vite.config.js), así que basta la ruta relativa.
VITE_API_BASE_URL=/api

# Configuración para Laravel Reverb / WebSockets.
# Debe coincidir con REVERB_APP_KEY del backend.
# Ojo: todo lo que empiece con VITE_ termina dentro del bundle del navegador.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
